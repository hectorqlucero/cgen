{:entity :users
 :title "Users"  ;; Edit this to your preference
 :table "users"
 :connection :default
 :rights ["A" "S"]  ;; User levels: U=User, A=Admin, S=System
 :mode :parameter-driven
 :menu-category :Users
 :menu-icon "bi bi-person-circle"
 :dropdown-menu "bi bi-people"

 ;; Fields auto-detected from database schema
 :fields [{:id :id :label "ID" :type :hidden}
          {:id :lastname :label :users/lastname :type :text :placeholder "Lastname..."}
          {:id :firstname :label :users/firstname :type :text :placeholder "Firstname..."}
          {:id :username :label :users/username :type :text :placeholder "Username..."}
          ; {:id :password :label "Password" :type :password}
          {:id :dob :label :users/dob :type :date :placeholder "Dob..."}
          {:id :cell :label :users/cell :type :text :placeholder "Cell..."}
          {:id :phone :label :users/phone :type :text :placeholder "Phone..."}
          {:id :fax :label :users/fax :type :text :placeholder "Fax..."}
          {:id :email :label :users/email :type :email :placeholder "user@example.com"}
          {:id :level :label :users/level :type :select :options [{:value "" :label "Select Level"}
                                                                  {:value "U" :label "User"}
                                                                  {:value "A" :label "Adminitstrator"}
                                                                  {:value "S" :label "System"}]}
          {:id :active :label :users/active :type :radio :value "T" :options [{:id "activeT" :value "T" :label "Active"}
                                                                              {:id "activeF" :value "F" :label "Inactive"}]}
          ; {:id :imagen :label "Imagen" :type :file}
          ; {:id :last_login :label "Last Login" :type :textarea :placeholder "Last Login..."}
          ]

 ;; Auto-generated queries (customize as needed)
 :queries {:list "SELECT * FROM users ORDER BY id DESC"
           :get "SELECT * FROM users WHERE id = ?"}

 ;; Available actions
 :actions {:new true :edit true :delete true}

 ;; Enable audit trail (tracks who created/modified and when)
 ;; Uncomment to enable:
 ;; :audit? true

 ;; Lifecycle hooks for business logic
 ;; Senior developer: Implement these in src/cgen/hooks/users.clj
 :hooks {:before-save :pizza.hooks.users/before-save}
