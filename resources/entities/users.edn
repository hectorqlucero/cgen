{:entity :users
 :title "Users"
 :table "users"
 :connection :default
 :rights ["U" "A" "S"]
 :mode :parameter-driven
 :menu-order 999
 :menu-icon "bi bi-person"
 :menu-category :Users

 :fields [{:id :id :label "ID" :type :hidden}
          {:id :lastname :label "Apellidos" :type :text :placeholder "Lastname..."}
          {:id :firstname :label "Nombre" :type :text :placeholder "Firstname..."}
          {:id :username :label "Usuario" :type :text :placeholder "Username..."}
          {:id :dob :label "Fecha de Nacimiento" :type :date :placeholder "Dob..."}
          {:id :cell :label "Celular" :type :text :placeholder "Cell..."}
          {:id :phone :label "Telefono" :type :text :placeholder "Phone..."}
          {:id :fax :label "Fax" :type :text :placeholder "Fax..."}
          {:id :email :label "Email" :type :email :placeholder "user@example.com"}
          {:id :level :label "Nivel" :type :radio :options [{:value "U" :label "Usuario"}
                                                            {:value "A" :label "Administrador"}
                                                            {:value "S" :label "Sistema"}]}
          {:id :active :label "Status" :type :radio :value "T" :options [{:id "activeT" :value "T" :label "Activo"}
                                                                         {:id "activeF" :value "F" :label "Inactivo"}]}
          ;; {:id :imagen :label "Imagen" :type :file}
          ;; {:id :last_login :label "Last Login" :type :textarea :placeholder "Last Login..."}
          ]

 :queries {:list "SELECT * FROM users ORDER BY id DESC"
           :get "SELECT * FROM users WHERE id = ?"}

 :actions {:new true :edit true :delete true}}
